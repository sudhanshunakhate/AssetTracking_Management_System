@echo off
REM Copy to %%CATALINA_HOME%%\bin\setenv.bat and edit values (Windows)
set "CAITS_DB=2"
set "CAITS_CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_HOST:8080"
set "CAITS_SECURITY_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32PLUS"
set "CAITS_SECURITY_FIELD_ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32PLUS"
set "CAITS_SECURITY_COOKIE_SECURE=false"
set "CAITS_SECURITY_COOKIE_SAME_SITE=Lax"
set "CAITS_STORAGE_UPLOAD_DIR=C:\caits\uploads"
set "CAITS_LOG_FILE=C:\caits\logs\caits-app.log"
REM Optional JDBC overrides:
REM set "SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/caits?currentSchema=caits"
REM set "SPRING_DATASOURCE_USERNAME=caits"
REM set "SPRING_DATASOURCE_PASSWORD=CHANGE_ME"
