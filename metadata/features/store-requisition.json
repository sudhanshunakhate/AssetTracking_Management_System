{
  "id": "store-requisition",
  "status": "done",
  "description": "Store Requisition (MATERIAL_REQUISITION) rebuilt as a dedicated list + form page with a Department/Employee variant toggle, a multi-row item grid with live available-stock lookup, file attachments, an approvals block and approve/reject actions. Every form field maps to a txn_header_mst / txn_detail_dtl column end to end.",
  "files": [
    "frontend/src/features/transactions/RequisitionPage.tsx",
    "frontend/src/features/transactions/RequisitionItemLines.tsx",
    "frontend/src/components/form/LookupSelect.tsx",
    "frontend/src/components/ui/Modal.tsx",
    "frontend/src/api/transactions.ts",
    "frontend/src/api/client.ts",
    "frontend/src/api/masters.ts",
    "frontend/src/features/auth/AuthContext.tsx",
    "frontend/src/types/transactions.ts",
    "backend/src/main/java/com/caits/modules/files/FileStorageController.java",
    "backend/src/main/java/com/caits/modules/transactions/TxnDtos.java",
    "backend/src/main/java/com/caits/modules/transactions/TxnDocumentService.java",
    "backend/src/main/java/com/caits/domain/repository/TxnDetailDtlRepository.java",
    "backend/src/main/java/com/caits/modules/masters/controller/SetupMastersController.java",
    "backend/src/main/java/com/caits/modules/masters/service/SetupMastersService.java",
    "backend/src/main/java/com/caits/config/DataSeeder.java",
    "db_approach/seed_department_designation_lookups.sql"
  ],
  "api_endpoints": [
    "GET /requisitions (now returns requiredByDate + totalItems)",
    "GET /requisitions/{docId}",
    "POST /requisitions",
    "PUT /requisitions/{docId}",
    "POST /requisitions/{docId}/approve",
    "POST /requisitions/{docId}/reject",
    "GET /stock?itemId=&locationId= (available qty for the line grid)",
    "GET /general-types/GTY-DEPT/values",
    "GET /general-types/GTY-DESIG/values",
    "POST /general-types/{typeCode}/values (inline quick-add)",
    "POST /files (attachment upload)",
    "GET /files/{yyyy}/{MM}/{name} (attachment download)"
  ],
  "db_tables": ["txn_header_mst", "txn_detail_dtl", "genmaster_mst", "gentype_mst", "inv_stock_mst"],
  "field_map": {
    "Requisition Type": "txh_doc_subtype (DEPARTMENT | EMPLOYEE)",
    "Requisition No.": "txh_doc_no (auto MREQ-yyyy-####)",
    "Requisition Date": "txh_doc_date",
    "Required Date": "txh_required_by_date",
    "Department": "txh_department_id_gmst (FK genmaster_mst, GTY-DEPT)",
    "Requested By": "txh_initiated_by_emp_id_emp",
    "Employee Id": "txh_employee_ref_code",
    "Issued to Department": "txh_department_id_gmst (resolved from the employee's department)",
    "Designation": "txh_designation (GTY-DESIG value name)",
    "Deliver to Location": "txh_location_id_loc",
    "Attachment": "txh_attachment_url",
    "Remark": "txh_remarks",
    "Approved By": "txh_approved_by_emp_id_emp",
    "Approved Date": "txh_approved_date",
    "Status": "txh_status",
    "line.Sr No.": "txd_sr_no",
    "line.Item Code / Name": "txd_item_id_itm",
    "line.UOM": "txd_uom_id_unt",
    "line.Requested Qty": "txd_requested_qty (also mirrored to txd_qty)",
    "line.Available Stock": "txd_available_stock (snapshot from GET /stock)",
    "line.Location": "txd_location_id_loc",
    "line.Remark": "txd_remark"
  },
  "depends_on": ["app-shell", "masters-phase1", "auth-login", "transactions-phase2"],
  "notes": "Status flow: Draft -> Pending Approval (SUBMIT) -> Approved/Rejected. Edit and delete are only permitted on Draft/Rejected, matching the backend rule. Approve/Reject buttons honour the SR menu's approve/reject permissions (canApproveMenu / canRejectMenu added to AuthContext). Attachments are stored on local disk under caits.storage.upload-dir (default backend/uploads, gitignored) and served back via GET /files. The Remark field is a plain textarea — txh_remarks is a plain string column, so the wireframe's rich-text toolbar is not implemented.",
  "updated": "2026-08-01"
}
